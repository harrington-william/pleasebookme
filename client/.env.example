# -----------------------------------------------------------------------------
# PleaseBookMe — Next.js client environment template
#
# Copy to `.env` and fill in per-environment values:
#   cp .env.example .env
#
# Variables WITHOUT the NEXT_PUBLIC_ prefix are server-only: they are readable
# from Route Handlers, Server Components and proxy.ts, and are never shipped to
# the browser bundle. Variables WITH the prefix are inlined at build time and
# are therefore PUBLIC — never put a secret behind NEXT_PUBLIC_.
#
# Every variable here is validated at startup by lib/env.ts. A missing or
# malformed value fails loudly rather than surfacing as a confusing runtime bug.
# -----------------------------------------------------------------------------

# --- Spring Boot platform API (server-only, REQUIRED) ------------------------
# Base origin of the centralized reservation platform. The browser NEVER calls
# this directly; only the Next.js BFF route handlers under /api/auth/* do.
API_BASE_URL=http://localhost:8080

# Upstream request timeout in milliseconds. Optional, defaults to 15000.
API_TIMEOUT_MS=15000

# --- Client-visible application config ---------------------------------------
NEXT_PUBLIC_APP_NAME=PleaseBookMe
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Feature flags ------------------------------------------------------------
# Google OAuth2 is scaffolded on the server but has no working redirect/callback
# flow yet. Keep false until the backend implements it.
NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED=false
